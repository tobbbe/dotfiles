{
  "alwaysThinkingEnabled": true,
  "respectGitignore": false,
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch",
      "WebSearch",
      "Bash(*)",
      "mcp__*"
    ],
    "defaultMode": "auto"
  },
  "tui": "fullscreen",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/load-agentbrain.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/notify-session.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dev/dotfiles/scripts/agent-notifications.sh \"Claude Code\" \"Needs your attention\""
          }
        ]
      }
    ]
  }
}
