{
  "alwaysThinkingEnabled": true,
  "respectGitignore": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash",
      "mcp__*"
    ],
    "defaultMode": "auto"
  },
  "tui": "fullscreen",
  "theme": "custom:poppy",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/load-agentbrain.sh"
          }
        ]
      }
    ]
  }
}
